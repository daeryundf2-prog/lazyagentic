{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/intent-guard/intent-guard.mjs\"",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/intent-guard/intent-guard.mjs\"",
            "timeout": 5,
            "description": "turn audit: transcript_path 기반 턴 종료 감사"
          }
        ]
      }
    ]
  }
}
